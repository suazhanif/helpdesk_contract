<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_contractor" model="ir.ui.view">
        <field name="name">res.partner.form.contractor</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_contractor_jobs" type="object" class="oe_stat_button"
                        icon="fa-wrench" invisible="contractor_job_count == 0"
                        groups="helpdesk.group_helpdesk_user">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="contractor_job_count"/></span>
                        <span class="o_stat_text">Contractor Jobs</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="is_contractor"/>
            </xpath>
        </field>
    </record>

    <record id="view_res_partner_filter_contractor" model="ir.ui.view">
        <field name="name">res.partner.search.contractor</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter string="Contractors / Vendors" name="contractors" domain="[('is_contractor', '=', True)]"/>
            </xpath>
        </field>
    </record>
</odoo>
