<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Purchase order: "Is an Asset" per line, Assets smart button, Create Assets -->
    <record id="purchase_order_form_asset" model="ir.ui.view">
        <field name="name">purchase.order.form.asset</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="has_pending_asset_lines" invisible="1"/>
                <button name="action_open_asset_wizard" type="object" string="Create Assets"
                        icon="fa-cubes" class="btn-secondary"
                        invisible="state not in ('purchase', 'done') or not has_pending_asset_lines"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_assets" type="object" class="oe_stat_button"
                        icon="fa-cubes" invisible="asset_count == 0">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="asset_count"/></span>
                        <span class="o_stat_text">Assets</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="after">
                <field name="is_asset" optional="show" widget="boolean_toggle"
                       readonly="parent.state in ('purchase', 'done', 'cancel')"/>
            </xpath>
        </field>
    </record>

    <!-- Product: "Purchased as Asset" next to Can be Sold / Can be Purchased -->
    <record id="product_template_form_asset" model="ir.ui.view">
        <field name="name">product.template.form.purchased.asset</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-flex">
                    <field name="is_asset_product"/>
                    <label for="is_asset_product"/>
                </span>
            </xpath>
        </field>
    </record>
</odoo>